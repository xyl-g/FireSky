                                                <CheckBox x:Name="CustomRegionToggle" Content="自定义范围" FontSize="11.5"
                                                          Checked="OnCustomRegionToggled" Unchecked="OnCustomRegionToggled"/>
                                                <StackPanel x:Name="CustomBoundsFields" Spacing="8" Visibility="Collapsed">
                                                    <TextBlock Text="可拖拽地图绘制范围；跨 180° 经线取短弧。" FontSize="10" Opacity=".6"
                                                               TextWrapping="Wrap"/>
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <NumberBox x:Name="West" Header="西界" Value="119.5" Minimum="-180" Maximum="180" SmallChange="0.25" ValueChanged="OnBoundsChanged"/>
                                                        <NumberBox x:Name="East" Grid.Column="1" Header="东界" Value="120.5" Minimum="-180" Maximum="180" SmallChange="0.25" ValueChanged="OnBoundsChanged"/>
                                                    </Grid>
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <NumberBox x:Name="South" Header="南界" Value="29.75" Minimum="-90" Maximum="90" SmallChange="0.25" ValueChanged="OnBoundsChanged"/>
                                                        <NumberBox x:Name="North" Grid.Column="1" Header="北界" Value="30.75" Minimum="-90" Maximum="90" SmallChange="0.25" ValueChanged="OnBoundsChanged"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Card 2: 观测参数 -->
                                    <Border Padding="11" CornerRadius="14"
                                            Background="{ThemeResource FireSkyCardBrush}"
                                            BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="24" Height="24" CornerRadius="7"
                                                        Background="{ThemeResource FireSkyCoolTintBrush}">
                                                    <FontIcon Glyph="&#xE787;" FontSize="12"
                                                              Foreground="{ThemeResource FireSkyCoolAccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="观测参数" FontSize="13.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="目标日期" FontSize="11" Opacity=".7"/>
                                                <Border CornerRadius="11" Padding="3"
                                                        Background="{ThemeResource FireSkyPillTrackBrush}"
                                                        BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                    <Grid x:Name="DatePillHost" ColumnSpacing="2"/>
                                                </Border>
                                                <CalendarDatePicker x:Name="TargetDate" Header="日期" Visibility="Collapsed"
                                                                    HorizontalAlignment="Stretch"
                                                                    DateChanged="OnCustomDateChanged"/>
                                            </StackPanel>
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="观测时段" FontSize="11" Opacity=".7"/>
                                                <Border CornerRadius="11" Padding="3"
                                                        Background="{ThemeResource FireSkyPillTrackBrush}"
                                                        BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                    <Grid x:Name="PhenomenonPillHost" ColumnSpacing="2"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True"
                                             Closed="OnPageErrorBarClosed"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Spacing="6" Padding="0,10,4,0">
                                <Button x:Name="PredictButton" Content="开始预测"
                                        Background="{ThemeResource FireSkyAccentGradientBrush}"
                                        Foreground="{ThemeResource FireSkyAccentButtonForegroundBrush}" BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="10" Height="38" FontWeight="SemiBold"
                                        Click="OnPredict"/>
                                <TextBlock x:Name="SourcesLabel" Text="GFS + EC" HorizontalAlignment="Center"
                                           FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                </Grid>
                <!-- ============ 数据管理页（v1.2.0 瘦身：探测与同步在设置 → 数据） ============ -->
                <ScrollViewer x:Name="DataPage" Visibility="Collapsed">
                    <StackPanel Padding="32,26,32,32" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="数据管理" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock x:Name="DataWorkspaceText" FontSize="11" Opacity=".65"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="已统计占用仅覆盖模式数据（GFS / EC / CAMS）；地形与卫星以目录为准。"
                                       FontSize="11" Opacity=".6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <InfoBar x:Name="DataErrorBar" IsOpen="False" Severity="Error" IsClosable="True"
                                 Closed="OnPageErrorBarClosed"/>
                        <Border HorizontalAlignment="Left" CornerRadius="12" Padding="3"
                                Background="{ThemeResource FireSkyPillTrackBrush}"
                                BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Content="地形 SRTM" Click="OnDataTerrainAnchor" Padding="10,5"/>
                                <Button Content="本地缓存" Click="OnDataInventoryAnchor" Padding="10,5"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SyncSettingsJump" Click="OnOpenSyncSettings" Padding="10,5">
