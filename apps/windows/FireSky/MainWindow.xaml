<Window
    x:Class="FireSky.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:FireSky"
    Title="FireSky">
    <Grid x:Name="Root" Background="{ThemeResource FireSkyNavSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="20,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <local:FireSkyMark Width="28" Height="28"/>
                <TextBlock Text="FireSky" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="朝晚霞观测台" FontSize="11" Opacity=".65" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left"
                        OpenPaneLength="168" IsBackButtonVisible="Collapsed"
                        Background="{ThemeResource FireSkyNavPaneBrush}"
                        IsSettingsVisible="True" SelectionChanged="OnNavigationChanged">
            <NavigationView.PaneHeader>
                <TextBlock Text="观测工作台" FontSize="10" FontWeight="SemiBold" Opacity=".65" Margin="14,6,14,2"/>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="单点预测" Tag="point">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="MapPin"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="区域预测" Tag="regional">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Map"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="实况观测" Tag="nowcast">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Globe"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="数据管理" Tag="data">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="任务历史" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Background="{ThemeResource FireSkyPageBgBrush}">
                <Border IsHitTestVisible="False" Background="{ThemeResource FireSkyWarmGlowBrush}"/>
                <Border IsHitTestVisible="False" Background="{ThemeResource FireSkyCoolGlowBrush}"/>
                <!-- ============ 预测页（单点 / 区域 / 实况共用骨架，v2.2.0 对齐 macOS） ============ -->
                <Grid x:Name="ForecastPage">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="286"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1" Margin="14,10,18,14" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <InfoBar x:Name="StaleBanner" IsOpen="False" Severity="Warning" IsClosable="False"
                                         Title="参数已变更 · 当前结果对应旧参数"
                                         Message="表单改动不会自动重算，可按当前参数重新运行。">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="StaleRecalculateButton" Content="按新参数重算"
                                                Click="OnRecalculate"/>
                                    </InfoBar.ActionButton>
                                </InfoBar>
                                <InfoBar x:Name="NowcastNoticeBar" IsOpen="False" Severity="Informational" IsClosable="False"
                                         Title="实况窗口说明"
                                         Message="卫星实况仅适用距朝霞/晚霞 4 小时以内的当前观测窗口；远期日期请改用「单点预测」或「区域预测」。"/>
                                <InfoBar x:Name="NowcastMapWarningBar" IsOpen="False" Severity="Warning" IsClosable="False"
                                         Title="实况地图提示"/>
                            </StackPanel>
                            <Border x:Name="EmptyStatePanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
                                    Padding="24" CornerRadius="14" VerticalAlignment="Top"
                                    Background="{ThemeResource FireSkyCardBrush}"
                                    BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="18">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <local:FireSkyMarkScene/>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="EmptyStateTitle" Text="准备就绪，开始首次朝晚霞预测"
                                                       FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="EmptyStateDescription"
                                                       Text="预测完成后，这里会依次展示双模式行动结论、GFS 与 EC 独立指数、大气垂直剖面和逐时台账。"
                                                       FontSize="12" Opacity=".7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid x:Name="EmptyStateCards" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="14" CornerRadius="10"
                                                Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="双模式独立对比" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="GFS 0.25° 与 EC 公开数据各自评分（0–2.5），不平均、不互相填补。"
                                                           FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Padding="14" CornerRadius="10"
                                                Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="太阳方向大气剖面" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="沿太阳光路查看高中低云层、地形遮挡与理论受光高度。"
                                                           FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="14" CornerRadius="10"
                                                Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="最佳时刻与窗口" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="给出推荐到达时段、主要限制因素与模型云属代理。"
                                                           FontSize="11" Opacity=".7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ResultPanel" Grid.Row="1" Padding="14,10" CornerRadius="14"
                                    Background="{ThemeResource FireSkyCardBrush}"
                                    BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ResultContext" Text="等待预测" FontSize="11" Opacity=".68"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border x:Name="RegionalModelPillTrack" Grid.Column="1" Visibility="Collapsed"
                                                CornerRadius="12" Padding="3"
                                                Background="{ThemeResource FireSkyPillTrackBrush}"
                                                BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                            <StackPanel x:Name="RegionalResultModelPills" Orientation="Horizontal" Spacing="2"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="HeroHost" Spacing="4"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2" x:Name="ResultBody" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RegionalMapHost" Grid.Column="0" MinHeight="420" Visibility="Collapsed"
                                        CornerRadius="14" BorderBrush="{ThemeResource FireSkyCardBorderBrush}"
                                        BorderThickness="1" VerticalAlignment="Stretch"/>
                                <Border x:Name="RegionalInspector" Grid.Column="1"
                                        Visibility="Collapsed" Padding="14" CornerRadius="14"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource FireSkyCardBrush}"
                                        BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                    <ScrollViewer>
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="区域结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="RegionalInspectorMode"
                                                          Grid.Column="1"
                                                          HorizontalAlignment="Right" Width="118"
                                                          SelectedIndex="0"
                                                          SelectionChanged="OnRegionalInspectorModeChanged">
                                                    <ComboBoxItem Content="网格排行" Tag="grid"/>
                                                    <ComboBoxItem Content="城市排名" Tag="cities"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock x:Name="RegionalGridSummary" Text="等待预测"
                                                       FontSize="11" Opacity=".7"
                                                       TextWrapping="Wrap"/>
                                            <ListView x:Name="RegionalGridRows" SelectionMode="None"
                                                      MaxHeight="220"/>
                                            <ListView x:Name="CityRankingRows" SelectionMode="None"
                                                      MaxHeight="220" Visibility="Collapsed"/>
                                            <Border Padding="12" CornerRadius="10"
                                                    Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                    BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock x:Name="RegionalProfileSelection"
                                                                       Text="选择网格后读取冻结剖面"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="RegionalProfileStatus"
                                                                       Text="未选择网格" TextWrapping="Wrap" FontSize="11" Opacity=".8"/>
                                                        </StackPanel>
                                                        <Button x:Name="RegionalCrossSectionExpand"
                                                                Content="展开剖面图层" Padding="8,4"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Visibility="Collapsed"
                                                                Click="OnToggleRegionalCrossSection"/>
                                                    </Grid>
                                                    <Canvas x:Name="RegionalCrossSection" Height="250"
                                                            Visibility="Collapsed"
                                                            SizeChanged="OnRegionalCrossSectionSizeChanged"
                                                            Background="Transparent"/>
                                                    <ListView x:Name="RegionalProfileRows"
                                                              SelectionMode="None" MaxHeight="180"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                                <Grid x:Name="ResultTabs" Grid.ColumnSpan="2" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 顶部悬浮磨砂分页与模式控制条（对齐 macOS WorkAnalysisTabs） -->
                                    <Border Padding="8,6" CornerRadius="12"
                                            Background="{ThemeResource FireSkyCardBrush}"
                                            BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border HorizontalAlignment="Left" CornerRadius="13" Padding="3"
                                                    Background="{ThemeResource FireSkyPillTrackBrush}"
                                                    BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                <StackPanel x:Name="ResultTabPills" Orientation="Horizontal" Spacing="2"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border x:Name="ResultModelPillTrack" CornerRadius="13" Padding="3"
                                                        Background="{ThemeResource FireSkyPillTrackBrush}"
                                                        BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                    <StackPanel x:Name="ResultModelPills" Orientation="Horizontal" Spacing="2"/>
                                                </Border>
                                                <Button x:Name="DiagnosticsButton" Click="OnOpenDiagnostics"
                                                        Padding="10,4" CornerRadius="13" VerticalAlignment="Center"
                                                        Visibility="Collapsed"
                                                        ToolTipService.ToolTip="查看技术诊断与时间窗元数据">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE946;" FontSize="12"/>
                                                        <TextBlock Text="诊断" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 分页内容区：概览 / 大气剖面 / 逐时台账 -->
                                    <Grid Grid.Row="1">
                                        <ScrollViewer x:Name="OverviewTabPanel">
                                            <StackPanel Spacing="12" Padding="0,0,0,4">
                                                <Border x:Name="OverviewSummaryCard" Padding="14,12" CornerRadius="14"
                                                        Visibility="Collapsed"
                                                        Background="{ThemeResource FireSkyCardBrush}"
                                                        BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                                    <StackPanel x:Name="OverviewSummaryHost" Spacing="10"/>
                                                </Border>
                                                <StackPanel x:Name="PointVisualHost" Spacing="10" Visibility="Collapsed"/>
                                                <StackPanel x:Name="MetricHost" Spacing="10"/>
                                                <Border Padding="16" CornerRadius="14"
                                                        Background="{ThemeResource FireSkyCardBrush}"
                                                        BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <Grid>
                                                            <TextBlock Text="霞光质量变化" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="ChartLegend" HorizontalAlignment="Right"
                                                                       FontSize="10" Opacity=".7"/>
                                                        </Grid>
                                                        <Grid Height="196" SizeChanged="OnChartSizeChanged"
                                                              PointerMoved="OnChartPointerMoved"
                                                              PointerExited="OnChartPointerExited">
                                                            <Canvas x:Name="QualityChart"/>
                                                            <TextBlock x:Name="ChartEmpty" Text="运行预测后显示质量曲线" FontSize="10"
                                                                       Opacity=".55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="ChartToolTip" Visibility="Collapsed"
                                                                    Padding="8,5" CornerRadius="8"
                                                                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{ThemeResource FireSkyCardBorderBrush}"
                                                                    BorderThickness="1" HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top" IsHitTestVisible="False">
                                                                <TextBlock x:Name="ChartToolTipText" FontSize="10" IsTextSelectionEnabled="True"/>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="BreakdownCard" Padding="16" CornerRadius="14"
                                                        Background="{ThemeResource FireSkyCardBrush}"
                                                        BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1"
                                                        Visibility="Collapsed">
                                                    <StackPanel x:Name="BreakdownHost" Spacing="8"/>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <ScrollViewer x:Name="ProfileTabPanel" Visibility="Collapsed">
                                            <Border Padding="14" CornerRadius="14"
                                                    Background="{ThemeResource FireSkyCardBrush}"
                                                    BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock x:Name="ProfileTitleText" Text="太阳方向大气剖面" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="ProfileStatus" Text="等待预测" TextWrapping="Wrap"
                                                                       FontSize="11" Opacity=".75"/>
                                                        </StackPanel>
                                                        <Button x:Name="FrozenProfileButton" Grid.Column="1" Content="刷新冻结剖面"
                                                                Padding="10,4" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" Visibility="Collapsed"
                                                                Click="OnQueryPointProfile"/>
                                                    </Grid>
                                                    <Border x:Name="ProfileTakeawayBanner" Visibility="Collapsed"
                                                            Padding="10,6" CornerRadius="8" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon x:Name="ProfileTakeawayIcon" Glyph="&#xE706;" FontSize="12"/>
                                                            <TextBlock x:Name="ProfileTakeawayText" FontSize="11.5"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       MaxLines="1"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid x:Name="ProfileControlsBar" Visibility="Collapsed" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel x:Name="ProfileTelemetryPills" Orientation="Horizontal" Spacing="6"/>
                                                        <ToggleButton x:Name="ProfileIsobarsToggle" Grid.Column="1"
                                                                      IsChecked="False" Padding="9,3" CornerRadius="12"
                                                                      Click="OnProfileIsobarsToggled"
                                                                      ToolTipService.ToolTip="显示或隐藏等压参考线 (hPa)">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE9D9;" FontSize="11"/>
                                                                <TextBlock Text="等压线" FontSize="11"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </Grid>
                                                    <Grid x:Name="PointCrossSectionContainer" Height="284"
                                                          SizeChanged="OnCrossSectionSizeChanged"
                                                          PointerMoved="OnCrossSectionPointerMoved"
                                                          PointerExited="OnCrossSectionPointerExited">
                                                        <Canvas x:Name="PointCrossSection" Visibility="Collapsed"/>
                                                        <Line x:Name="CrossSectionCrosshair" Visibility="Collapsed"
                                                              IsHitTestVisible="False" StrokeThickness="1"
                                                              StrokeDashArray="3,3"
                                                              Stroke="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <Border x:Name="CrossSectionHoverCard" Visibility="Collapsed"
                                                                IsHitTestVisible="False" Margin="52,20,16,0"
                                                                Padding="9,6" CornerRadius="8"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource FireSkyCardBorderBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel x:Name="CrossSectionHoverHost" Spacing="3"/>
                                                        </Border>
                                                    </Grid>
                                                    <ScrollViewer x:Name="PointCrossSectionLegendScroll"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  Visibility="Collapsed">
                                                        <StackPanel x:Name="PointCrossSectionLegend"
                                                                    Orientation="Horizontal" Spacing="12" Padding="0,2"/>
                                                    </ScrollViewer>
                                                    <Border x:Name="PointCloudGenusBar" Visibility="Collapsed"
                                                            Padding="9,5" CornerRadius="6"
                                                            Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                            BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE753;" FontSize="11"
                                                                      Foreground="{ThemeResource FireSkyCoolAccentBrush}"/>
                                                            <TextBlock x:Name="PointCloudGenusText" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel x:Name="PointTargetsHost" Spacing="4" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="PointProfileNote" FontSize="11" Opacity=".65"
                                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                    <Expander x:Name="NowcastFrozenExpander" Header="按时次查询冻结剖面"
                                                              HorizontalAlignment="Stretch" Visibility="Collapsed">
                                                        <StackPanel Spacing="8" Padding="0,4,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ComboBox x:Name="NowcastProfileStepPicker" Width="260"/>
                                                                <Button x:Name="NowcastFrozenQueryButton" Content="读取"
                                                                        Click="OnQueryNowcastProfile" Padding="10,4"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="NowcastFrozenStatus" FontSize="11" Opacity=".75"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                        <ScrollViewer x:Name="LedgerTabPanel" Visibility="Collapsed"
                                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="LedgerHost" Margin="2,4,2,18" Spacing="0"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <!-- 左侧观测控制栏：双悬浮卡片 + 底部主行动按钮 -->
                        <Grid Padding="0" Margin="14,10,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer x:Name="ControlsScrollViewer" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Inputs" Spacing="8" Padding="0,0,4,0">
                                    <!-- Card 1: 观测点 -->
                                    <Border Padding="11" CornerRadius="14"
                                            Background="{ThemeResource FireSkyCardBrush}"
                                            BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="7">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="24" Height="24" CornerRadius="7"
                                                            Background="{ThemeResource FireSkyAccentTintBrush}">
                                                        <FontIcon Glyph="&#xE707;" FontSize="12"
                                                                  Foreground="{ThemeResource FireSkyAccentBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="观测点" FontSize="13.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border x:Name="LocationViewPillTrack" Grid.Column="1" CornerRadius="11" Padding="2"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource FireSkyPillTrackBrush}"
                                                        BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                    <StackPanel x:Name="LocationViewPills" Orientation="Horizontal" Spacing="2"/>
                                                </Border>
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索城市或地点"
                                                                QueryIcon="Find" QuerySubmitted="OnSearch"/>
                                                <Button x:Name="LocateButton" Grid.Column="1" Click="OnLocate"
                                                        Width="32" Height="32" Padding="0" CornerRadius="8"
                                                        ToolTipService.ToolTip="当前位置">
                                                    <FontIcon Glyph="&#xE81D;" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                            <Border x:Name="MiniMapHost" Height="114" CornerRadius="10"
                                                    BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                <controls:WebView2 x:Name="Map"/>
                                            </Border>
                                            <Border x:Name="FavoritesPanel" Visibility="Collapsed" Padding="8" CornerRadius="10"
                                                    Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                    BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <StackPanel x:Name="FavoritesHost" Spacing="4"/>
                                                    <TextBlock x:Name="FavoritesEmptyHint"
                                                               Text="暂无收藏地点，定位后点击「收藏当前点」可快速复用。"
                                                               FontSize="11" Opacity=".68" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel x:Name="PointFields" Spacing="8">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource FireSkyAccentBrush}"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="LocationSummaryName" Text="杭州" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LocationSummaryCoords" Text="30.2500° N, 120.2500° E"
                                                               FontSize="11" Opacity=".72" Margin="12,0,0,0"/>
