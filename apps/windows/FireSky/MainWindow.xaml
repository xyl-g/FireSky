                                                        <NumberBox x:Name="Longitude" Grid.Column="1" Header="经度" Value="120.25" Minimum="-180" Maximum="180" ValueChanged="OnCoordinatesChanged"/>
                                                    </Grid>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <NumberBox x:Name="Elevation" Header="海拔（m）" Value="20" Minimum="-500" Maximum="9000" ValueChanged="OnElevationOrZoneChanged"/>
                                                        <TextBox x:Name="Timezone" Grid.Column="1" Header="时区" Text="Asia/Shanghai" TextChanged="OnTimezoneChanged"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="获取海拔与时区" Click="OnMetadata" Padding="8,4" FontSize="11"/>
