                                                                <TextBlock x:Name="SummaryEngineText" Text="未连接" FontSize="13"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Padding="12,10" CornerRadius="10"
                                                            Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                            BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="后台同步" FontSize="11" Opacity=".68"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse x:Name="SummarySyncDot" Width="7" Height="7"
                                                                         Fill="{ThemeResource FireSkyWarningBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="SummarySyncText" Text="按需准备" FontSize="13"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Padding="12,10" CornerRadius="10"
                                                            Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                            BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="CAMS ADS" FontSize="11" Opacity=".68"/>
