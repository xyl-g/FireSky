                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" HorizontalAlignment="Center" Margin="24,18,24,8"
                            CornerRadius="18" Padding="4"
                            Background="{ThemeResource FireSkyPillTrackBrush}"
                            BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                        <StackPanel x:Name="SettingsCategoryPills" Orientation="Horizontal" Spacing="2"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <Grid HorizontalAlignment="Stretch" Padding="32,12,32,32">
                            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Spacing="16">
                                <InfoBar x:Name="SettingsErrorBar" IsOpen="False" Severity="Error" IsClosable="True"
                                         Closed="OnPageErrorBarClosed"/>
                                <Grid>
                                    <!-- 通用 -->
                                    <StackPanel x:Name="GeneralSettings" Spacing="16">
                                        <TextBlock Text="通用" Style="{ThemeResource TitleTextBlockStyle}"/>
