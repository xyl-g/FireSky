                                                                  Checked="OnMetadataReadyChanged" Unchecked="OnMetadataReadyChanged"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ElevationSourceNote" FontSize="10" Opacity=".6"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="RegionFields" Spacing="8" Visibility="Collapsed">
