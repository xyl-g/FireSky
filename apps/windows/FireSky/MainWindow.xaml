                                        <Border Padding="18" CornerRadius="14"
                                                Background="{ThemeResource FireSkyCardBrush}"
                                                BorderBrush="{ThemeResource FireSkyCardBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="14">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Border Width="28" Height="28" CornerRadius="7"
                                                                Background="{ThemeResource FireSkyAccentTintBrush}">
                                                            <FontIcon Glyph="&#xE9D9;" FontSize="14"
                                                                      Foreground="{ThemeResource FireSkyAccentBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="运行状态摘要" FontSize="14" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button Content="管理数据源与同步" Click="OnOpenSyncSettings"
                                                            Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Padding="12,10" CornerRadius="10"
                                                            Background="{ThemeResource FireSkyGroupedCardBrush}"
                                                            BorderBrush="{ThemeResource FireSkyGroupedBorderBrush}" BorderThickness="1">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="本地引擎" FontSize="11" Opacity=".68"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Ellipse x:Name="SummaryEngineDot" Width="7" Height="7"
