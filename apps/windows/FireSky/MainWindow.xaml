                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="SetDefaultRegionButton" Content="设为默认"
                                                            HorizontalAlignment="Stretch" FontSize="11"
                                                            ToolTipService.ToolTip="将当前区域设为默认"
                                                            Click="OnSetDefaultRegion" Padding="6,4"/>
                                                    <Button x:Name="ResetDefaultRegionButton" Grid.Column="1" Content="恢复默认"
                                                            HorizontalAlignment="Stretch" FontSize="11"
                                                            ToolTipService.ToolTip="恢复默认区域"
                                                            Click="OnResetDefaultRegion" Padding="6,4"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <CheckBox x:Name="ShowSmoothToggle" Content="平滑渲染" IsChecked="True" MinWidth="0" FontSize="11"
